{
  "redirects": [
    {
      "source": "/find",
      "destination": "/cases",
      "permanent": true
    },
    {
      "source": "/find/:id",
      "destination": "/p/:id",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "https://tools.salahome.tw",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "https://tools.salahome.tw/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/cases.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://hub.salahome.tw"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}