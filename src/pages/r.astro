---
// 租件單案頁：salahome.tw/r/?id=<永慶租屋網案號>
// 資料開頁時去後台的公開窗口（store_rentals）讀，只有租屋網上本來就公開的欄位；不放門牌、屋主資料。
// 照片用我們自己的圖庫（cases/rent<案號>/NN.webp），沒有才用租屋網封面。租屋網沒有房屋描述，所以沒有文案。
import StoreLayout from '../layouts/StoreLayout.astro';
import { AGENT } from '../lib/store';

const pageTitle = `出租物件｜${AGENT.brand} 心選好宅`;
---
<StoreLayout title={pageTitle} description={`${AGENT.brand}的出租物件，照片、月租金與看屋預約。`} path="/r/" noindex>
  <div id="rp" data-line-id={AGENT.lineId} class="hidden"></div>
  <main class="max-w-3xl mx-auto bg-white min-h-screen pb-28">
    <div class="px-4 pt-4"><a href="/cases" class="text-sm text-slate-500 hover:text-slate-800">← 回店鋪</a></div>
    <div id="loading" class="p-10 text-center text-slate-400">讀取中…</div>
    <div id="missing" class="hidden p-10 text-center text-slate-500">
      這間出租物件目前找不到（可能已經租出）。<br />歡迎直接 LINE 我，我幫您找類似的。
    </div>

    <article id="body" class="hidden">
      <section class="relative bg-slate-900 mt-3">
        <div id="gal" class="swiper mainSwiper">
          <div class="swiper-wrapper" id="mainWrap"></div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        </div>
        <span class="absolute top-3 left-3 z-10 bg-slate-900/80 text-amber-200 text-[11px] font-bold px-2.5 py-1 rounded-md pointer-events-none">租</span>
        <div id="thumbBox" class="hidden p-2 bg-slate-900/60 border-t border-white/10">
          <div class="swiper thumbsSwiper"><div class="swiper-wrapper" id="thumbWrap"></div></div>
        </div>
      </section>
      <div class="px-5 pt-5">
        <p id="place" class="text-sm text-slate-400 font-medium"></p>
        <h1 id="title" class="text-xl font-black text-slate-900 leading-snug mt-1"></h1>
        <p class="mt-3 flex items-baseline gap-1">
          <span id="rent" class="text-3xl font-black text-rose-600 tracking-tight"></span>
          <span id="unit" class="text-base font-extrabold text-rose-600">元／月</span>
        </p>
        <div id="specs" class="grid grid-cols-3 gap-2 mt-5"></div>
        <p class="mt-6 text-sm text-slate-500 leading-relaxed">
          想看這間？直接 LINE 我，我幫您約看屋時間，也可以一起看看買賣的好房子。
        </p>
        <p id="source" class="mt-4 text-xs text-slate-400"></p>
      </div>
    </article>
  </main>


  <div id="lightbox" class="fixed inset-0 z-[70] bg-black hidden">
    <button id="lbClose" type="button" class="absolute top-3 right-3 z-10 text-white bg-white/15 rounded-full px-3 py-2 text-sm" aria-label="關閉">關閉 ✕</button>
    <img src="/images/brand/sala-watermark.png" alt="" class="photo-wm absolute bottom-4 left-4 z-10 w-16 pointer-events-none select-none" />
    <div class="swiper lbSwiper h-full">
      <div class="swiper-wrapper" id="lbWrap"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </div>

  <div class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur border-t border-slate-200 z-20">
    <div class="max-w-3xl mx-auto flex gap-2 p-3">
      <a href={`tel:${AGENT.tel}`} class="flex-1 bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-bold h-12 rounded-xl flex items-center justify-center shadow-sm transition-transform">撥電話</a>
      <a id="lineBtn" href={AGENT.lineUrl} target="_blank" rel="noopener" class="bg-line hover:bg-lineHover flex-[1.3] text-white font-bold h-12 rounded-xl flex items-center justify-center shadow-sm active:scale-95 transition-transform">加 LINE 預約看屋</a>
    </div>
  </div>

  <script>
    import Swiper from 'swiper/bundle';
    import 'swiper/css/bundle';
    import { rentPhotoUrl, escapeHtml } from '../lib/rentCard';
    import type { Rental } from '../lib/rentCard';

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const id = new URLSearchParams(location.search).get('id') || '';
    const KEY = 'sb_publishable_TFAFZE-d5n0ElisMATr9rw_ku8be1xT';

    (async () => {
      let r: Rental | undefined;
      try {
        const res = await fetch('https://dlfleszjcfeickibjcee.supabase.co/rest/v1/rpc/store_rentals', {
          method: 'POST', headers: { apikey: KEY, Authorization: 'Bearer ' + KEY, 'Content-Type': 'application/json' }, body: '{}',
        });
        if (res.ok) r = ((await res.json()) as Rental[]).find((x) => x.id === id);
      } catch { /* 讀不到就顯示「找不到」，不影響其他頁 */ }
      $('loading').classList.add('hidden');
      if (!r) { $('missing').classList.remove('hidden'); return; }

      // 照片：圖庫有就用圖庫（1..N 張），沒有才用租屋網封面；跟售案一樣：大圖左右滑＋下方小圖＋點大圖放大
      const urls = r.photos && r.photos > 0 ? Array.from({ length: r.photos }, (_, i) => rentPhotoUrl(r!.id, i + 1)) : r.photo && /^https:\/\//.test(r.photo) ? [r.photo] : [];
      const wm = '<img src="/images/brand/sala-watermark.png" alt="" class="photo-wm absolute bottom-11 right-3 w-14 pointer-events-none select-none" />';
      if (urls.length) {
        $('mainWrap').innerHTML = urls.map((u, i) => `<div class="swiper-slide cursor-pointer" data-index="${i}"><div class="aspect-[4/3] w-full bg-slate-100 overflow-hidden relative"><img src="${escapeHtml(u)}" alt="${escapeHtml(r!.name)} 第 ${i + 1} 張" class="w-full h-full object-cover" loading="${i < 2 ? 'eager' : 'lazy'}" decoding="async" referrerpolicy="no-referrer" />${wm}<div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md text-white text-xs font-medium px-2.5 py-1 rounded-full">${i + 1} / ${urls.length}</div></div></div>`).join('');
        $('lbWrap').innerHTML = urls.map((u) => `<div class="swiper-slide flex items-center justify-center"><img src="${escapeHtml(u)}" alt="" class="max-w-full max-h-full object-contain" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>`).join('');
        let thumbs: Swiper | null = null;
        if (urls.length > 1) {
          $('thumbWrap').innerHTML = urls.map((u) => `<div class="swiper-slide cursor-pointer rounded-lg overflow-hidden"><div class="aspect-[4/3] w-full bg-slate-100"><img src="${escapeHtml(u)}" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div></div>`).join('');
          $('thumbBox').classList.remove('hidden');
          thumbs = new Swiper('.thumbsSwiper', { spaceBetween: 8, slidesPerView: 5, freeMode: true, watchSlidesProgress: true });
        }
        new Swiper('.mainSwiper', {
          navigation: { nextEl: '.mainSwiper .swiper-button-next', prevEl: '.mainSwiper .swiper-button-prev' },
          ...(thumbs ? { thumbs: { swiper: thumbs } } : {}),
        });
        // 點大圖放大
        const lightbox = $('lightbox');
        let lb: Swiper | null = null;
        document.querySelectorAll<HTMLElement>('.mainSwiper .swiper-slide').forEach((el) =>
          el.addEventListener('click', () => {
            lightbox.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            if (!lb) lb = new Swiper('.lbSwiper', { navigation: { nextEl: '.lbSwiper .swiper-button-next', prevEl: '.lbSwiper .swiper-button-prev' } });
            lb.slideTo(Number(el.dataset.index || 0), 0);
          }));
        $('lbClose').addEventListener('click', () => { lightbox.classList.add('hidden'); document.body.style.overflow = ''; });
      } else {
        $('mainWrap').innerHTML = '<div class="swiper-slide"><div class="aspect-[4/3] grid place-items-center text-slate-300 text-sm bg-slate-100">照片整理中</div></div>';
      }

      const place = `${r.district ?? ''}${r.road ? `・${r.road}` : ''}`;
      $('place').textContent = place;
      $('title').textContent = r.name;
      if (r.rent != null) { $('rent').textContent = r.rent.toLocaleString('en-US'); } else { $('rent').textContent = '租金洽詢'; $('unit').classList.add('hidden'); }
      const cells: [string, string][] = [
        ['型態', [r.type, r.category].filter((x, i, a) => x && a.indexOf(x) === i).join('・')],
        [r.category === '土地' ? '土地坪數' : '坪數', r.ping ? `${r.ping} 坪` : ''],
        ['樓層', r.floor ?? ''],
        ['車位', r.parking ? '有車位' : ''],
        ['生活圈', r.area ?? ''],
      ].filter((c): c is [string, string] => !!c[1]);
      $('specs').innerHTML = cells.map(([k, v]) => `<div class="bg-slate-50 rounded-xl p-3 text-center"><p class="text-xs text-slate-400">${escapeHtml(k)}</p><p class="text-sm font-bold text-slate-800 mt-1">${escapeHtml(v)}</p></div>`).join('');

      document.title = `${r.name}｜出租｜蔡莎拉 心選好宅`;
      // LINE 預約：帶案名與租屋網案號，莎拉一看就知道是哪一間
      const lineId = $('rp').dataset.lineId || '';
      const msg = `您好，我想了解出租物件「${r.name}」（案號 ${r.id}），想預約看屋。`;
      ($('lineBtn') as HTMLAnchorElement).href = `https://line.me/R/oaMessage/${lineId}/?${encodeURIComponent(msg)}`;
      $('body').classList.remove('hidden');
    })();
  </script>
</StoreLayout>
