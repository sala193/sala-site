---
// 蔡莎拉專屬店鋪：salahome.tw/cases
// 放全店銷售中的案子（資料天天由永慶官網公開頁自動同步），每件都標蔡莎拉；沒有同業廣告。
import StoreLayout from '../layouts/StoreLayout.astro';
import Icon from '../components/store/Icon.astro';
import { AGENT, allCases, photosOf, priceParts, districtOf, kindOf, roadOf, titleOf } from '../lib/store';

const cases = allCases().map((it) => {
  const [pn, pu] = priceParts(it.price);
  return {
    id: it.id,
    name: titleOf(it),
    district: districtOf(it),
    road: roadOf(it),
    kind: kindOf(it),
    type: it.type,
    rooms: it.rooms,
    ping: it.buildingPing || it.landPing,
    price: it.price || 0,
    priceNum: pn,
    priceUnit: pu,
    cut: it.originalPrice && it.price && it.originalPrice > it.price ? it.originalPrice - it.price : 0,
    cover: photosOf(it)[0] || '',
    isNew: it.isNew,
  };
});

const districts = [...new Set(cases.map((c) => c.district))].sort((a, b) =>
  cases.filter((c) => c.district === b).length - cases.filter((c) => c.district === a).length);
const kinds = ['住宅', '透天', '店面辦公', '廠房', '土地'].filter((k) => cases.some((c) => c.kind === k));
const title = `${AGENT.brand}的店鋪｜鶯歌．鳳鳴好房`;
const desc = `${AGENT.brand}（${AGENT.store}）目前在賣的房子，共 ${cases.length} 間，每間都可以直接問我。`;
---
<StoreLayout title={title} description={desc} image={cases[0]?.cover} path="/cases">
  <header class="bg-white border-b border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 pt-6 pb-5 text-center">
      <img src={AGENT.headshot} alt={AGENT.name} class="w-20 h-20 rounded-full object-cover object-top mx-auto shadow-md border-2 border-white" />
      <h1 class="text-xl font-black text-slate-900 mt-3">房仲莎拉的店鋪</h1>
      <p class="text-xs text-slate-500 mt-0.5">{AGENT.store}｜{AGENT.name}</p>
      <p class="text-sm text-slate-600 mt-2">鶯歌・鳳鳴・八德，目前在賣的好房都在這裡</p>
    </div>
  </header>

  <section class="sticky top-0 z-30 bg-slate-50/95 backdrop-blur-md border-b border-slate-200/70">
    <div class="max-w-5xl mx-auto px-4 pt-3 pb-2">
      <div class="flex gap-2 overflow-x-auto no-scrollbar pb-2" id="kindChips">
        <button type="button" data-kind="" class="chip shrink-0 px-3.5 py-1.5 rounded-full text-sm font-semibold border bg-slate-900 text-white border-slate-900">全部 {cases.length}</button>
        {kinds.map((k) => (
          <button type="button" data-kind={k} class="chip shrink-0 px-3.5 py-1.5 rounded-full text-sm font-semibold border bg-white text-slate-700 border-slate-200">{k} {cases.filter((c) => c.kind === k).length}</button>
        ))}
      </div>
      <div class="flex gap-2">
        <select id="district" aria-label="區域" class="flex-1 text-sm px-3 py-2 rounded-xl border border-slate-200 bg-white">
          <option value="">全部區域</option>
          {districts.map((d) => <option value={d}>{d}</option>)}
        </select>
        <select id="sort" aria-label="排序" class="flex-1 text-sm px-3 py-2 rounded-xl border border-slate-200 bg-white">
          <option value="new">預設排序</option>
          <option value="asc">總價低到高</option>
          <option value="desc">總價高到低</option>
        </select>
      </div>
      <p class="text-xs text-slate-400 mt-2" id="count">共 {cases.length} 間</p>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-4">
    <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cases.map((c, i) => (
        <a href={`/p/${c.id}`} class="card block bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-shadow" data-kind={c.kind} data-district={c.district} data-price={c.price} data-i={i}>
          <div class="relative aspect-[4/3] bg-slate-100 grid place-items-center text-slate-300 text-sm">
            {c.cover ? <img src={c.cover} alt={c.name} class="w-full h-full object-cover" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" /> : <span>照片整理中</span>}
            <div class="absolute top-2.5 left-2.5 flex gap-1.5">
              {c.isNew && <span class="bg-rose-600/95 text-white text-[11px] font-bold px-2.5 py-1 rounded-md">✨ 新上架</span>}
              {c.cut > 0 && <span class="bg-rose-600/95 text-white text-[11px] font-bold px-2.5 py-1 rounded-md">🔥 降 {c.cut.toLocaleString('en-US')} 萬</span>}
            </div>
          </div>
          <div class="p-4">
            <p class="text-xs text-slate-400 font-medium">{c.district}{c.road ? `・${c.road}` : ''}</p>
            <h2 class="text-base font-bold text-slate-900 leading-snug mt-0.5 line-clamp-2">{c.name}</h2>
            <p class="text-xs text-slate-500 mt-1.5">{[c.type, c.rooms, c.ping ? `${c.ping} 坪` : ''].filter(Boolean).join('｜')}</p>
            <p class="mt-2 flex items-baseline gap-1">
              <span class="text-2xl font-black text-rose-600 tracking-tight">{c.priceNum}</span>
              <span class="text-sm font-extrabold text-rose-600">{c.priceUnit}</span>
            </p>
          </div>
        </a>
      ))}
    </div>
    <p id="empty" class="hidden text-center text-slate-400 text-sm py-12">這個條件目前沒有房子，換個條件看看，或直接 LINE 我。</p>
  </main>

  <footer class="max-w-5xl mx-auto px-4 pb-6 text-center text-xs text-slate-400 space-y-1">
    <div>{AGENT.company}｜{AGENT.store}</div>
    <div>{AGENT.broker}</div>
    <div>{AGENT.agent}</div>
    <div>資料來源：永慶不動產公開物件資料，實際以現場及地政機關登記為準。</div>
    <div class="pt-2 space-x-3">
      <a href="/" class="text-slate-500">蔡莎拉官網首頁</a>
      <a href="/communities" class="text-slate-500">社區資料庫</a>
      <a href="/articles" class="text-slate-500">不動產知識</a>
      <a href="/contact" class="text-slate-500">我要賣屋</a>
    </div>
  </footer>

  <div class="fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200/90 py-2.5 px-4 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
    <div class="max-w-md mx-auto flex items-center space-x-2.5" style="padding-bottom: env(safe-area-inset-bottom)">
      <a href={`tel:${AGENT.tel}`} class="flex-1 bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-bold h-12 rounded-xl flex items-center justify-center space-x-1.5 shadow-sm transition-transform">
        <Icon name="phone-call" class="w-4 h-4 text-amber-400" />
        <span class="text-sm">撥打電話</span>
      </a>
      <a href={AGENT.line} target="_blank" rel="noopener" class="flex-[1.3] bg-line hover:bg-lineHover active:scale-95 text-white font-bold h-12 rounded-xl flex items-center justify-center shadow-md transition-transform">
        <span class="text-sm">加 LINE 找房</span>
      </a>
    </div>
  </div>

  <script>
    const grid = document.getElementById('grid')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const districtSel = document.getElementById('district') as HTMLSelectElement;
    const sortSel = document.getElementById('sort') as HTMLSelectElement;
    const chips = [...document.querySelectorAll<HTMLElement>('#kindChips .chip')];
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const ON = ['bg-slate-900', 'text-white', 'border-slate-900'];
    const OFF = ['bg-white', 'text-slate-700', 'border-slate-200'];
    let kind = '';
    function apply() {
      let shown = 0;
      for (const c of cards) {
        const ok = (!kind || c.dataset.kind === kind) && (!districtSel.value || c.dataset.district === districtSel.value);
        c.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      const ordered = [...cards];
      if (sortSel.value === 'asc') ordered.sort((a, b) => +a.dataset.price! - +b.dataset.price!);
      else if (sortSel.value === 'desc') ordered.sort((a, b) => +b.dataset.price! - +a.dataset.price!);
      else ordered.sort((a, b) => +a.dataset.i! - +b.dataset.i!);
      ordered.forEach((c) => grid.appendChild(c));
      count.textContent = `共 ${shown} 間`;
      empty.classList.toggle('hidden', shown > 0);
    }
    chips.forEach((b) => b.addEventListener('click', () => {
      kind = b.dataset.kind || '';
      chips.forEach((x) => {
        const on = x === b;
        x.classList.remove(...(on ? OFF : ON));
        x.classList.add(...(on ? ON : OFF));
      });
      apply();
    }));
    districtSel.addEventListener('change', apply);
    sortSel.addEventListener('change', apply);
  </script>
</StoreLayout>
