---
// 蔡莎拉專屬店鋪：salahome.tw/cases
// 放全店銷售中的案子（資料天天由永慶官網公開頁自動同步），每件都標蔡莎拉；沒有同業廣告。
import StoreLayout from '../layouts/StoreLayout.astro';
import Icon from '../components/store/Icon.astro';
import { AGENT, allCases, soldCases, photosOf, priceParts, districtOf, kindOf, roadOf, titleOf } from '../lib/store';
import { AGE_BUCKETS, flagsOf, LIVING_AREAS, PRICE_STEPS, priceLabel } from '../lib/caseFilter';

const cases = allCases().map((it) => {
  const [pn, pu] = priceParts(it.price);
  return {
    id: it.id,
    name: titleOf(it),
    district: districtOf(it),
    road: roadOf(it),
    kind: kindOf(it),
    flags: flagsOf(it),
    age: typeof it.age === 'number' ? it.age : null,
    type: it.type,
    rooms: it.rooms,
    ping: it.buildingPing || it.landPing,
    price: it.price || 0,
    priceNum: pn,
    priceUnit: pu,
    cut: it.originalPrice && it.price && it.originalPrice > it.price ? it.originalPrice - it.price : 0,
    cover: photosOf(it)[0] || '',
    isNew: it.isNew,
  };
});

// 最近成交（近 6 個月、最多 12 件）：照片、劃掉的開價＋「已成交」紅章（跟存檔頁同一個樣子）、區域路段、案名、型態坪數；
// 不放成交價、不放成交日期，也不連到單案頁
const soldList = soldCases().map((it) => {
  const [pn, pu] = priceParts(it.price);
  const name = titleOf(it);
  const district = districtOf(it);
  const road = roadOf(it);
  const place = `${district}${road ? `・${road}` : ''}`;
  const lineHref = (ask: string) => `https://line.me/R/oaMessage/${AGENT.lineId}/?${encodeURIComponent(ask)}`;
  return {
    id: it.id,
    name,
    place,
    // 沒有開價（價格洽詢）就不放劃掉的數字，只蓋章
    priceNum: it.price ? pn : '',
    priceUnit: it.price ? pu : '',
    cover: photosOf(it)[0] || '',
    info: [it.type, it.rooms, (it.buildingPing || it.landPing) ? `${it.buildingPing || it.landPing} 坪` : ''].filter(Boolean).join('｜'),
    buyHref: lineHref(`莎拉您好，我在店鋪看到已成交的「${name}」（${place}），想買類似的房子。`),
    sellHref: lineHref(`莎拉您好，我在店鋪看到已成交的「${name}」（${place}），想請您幫我估價我的房子。`),
  };
});

const districts = [...new Set(cases.map((c) => c.district))].sort((a, b) =>
  cases.filter((c) => c.district === b).length - cases.filter((c) => c.district === a).length);
// 篩選按鈕：兩排、不用左右滑（手機按鈕太多不好按）；廠房、土地收在「進階」裡
const CHIP = 'chip h-9 px-3.5 rounded-full text-sm font-semibold border bg-white text-slate-700 border-slate-200';
const roomChips: [string, string][] = [['2', '2房'], ['3', '3房'], ['4+', '4房以上']];
const condChips: [string, string, string][] = [['parking', '', '車位'], ['types', 'elevator', '電梯'], ['types', 'apartment', '公寓'], ['types', 'townhouse', '透天']];
const advChips: [string, string, string][] = [['types', 'factory', '廠房'], ['types', 'land', '土地']];
// 租／售（跟後台一樣放進進階）：出售（預設，出租案件不出現）／出租（莎拉 2026-10-11 不要「租和售」）
const dealChips: [string, string][] = [['', '出售'], ['rent', '出租']];
// 生活圈（進階，可多選）：由後台資料庫算好，開頁面時讀（見下方 script）
const areaChips: [string, string][] = LIVING_AREAS.map((a) => [a.key, a.label]);
// 屋齡（進階，可多選）
const ageChips: [string, string][] = AGE_BUCKETS.map((b) => [b.key, b.label]);
const title = `${AGENT.brand}的店鋪｜鶯歌．鳳鳴好房`;
const desc = `${AGENT.brand}（${AGENT.store}）目前在賣的房子，共 ${cases.length} 間，每間都可以直接問我。`;
---
<StoreLayout title={title} description={desc} image={cases[0]?.cover} path="/cases">
  <div id="bookNote" class="hidden bg-orange-50 border-b border-orange-100 px-4 py-3 text-center">
    <p class="text-sm font-bold text-slate-900">預約看屋，直接跟莎拉說就好</p>
    <p class="text-xs text-slate-600 mt-0.5">告訴我想看哪一間、什麼時候方便，我幫您安排。</p>
    <a href={AGENT.lineUrl} class="inline-block mt-2 bg-line text-white text-sm font-bold px-5 py-2 rounded-xl">LINE 通話／聊聊</a>
  </div>
  <header class="bg-white border-b border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 pt-6 pb-5 text-center">
      <img src={AGENT.headshot} alt={AGENT.name} class="w-20 h-20 rounded-full object-cover object-top mx-auto shadow-md border-2 border-white" />
      <h1 class="text-xl font-black text-slate-900 mt-3">房仲莎拉的店鋪</h1>
      <p class="text-xs text-slate-500 mt-0.5">{AGENT.store}｜{AGENT.name}</p>
      <p class="text-sm text-slate-600 mt-2">鶯歌・鳳鳴・八德，目前在賣的好房都在這裡</p>
    </div>
  </header>

  {soldList.length > 0 && (
    <nav class="max-w-5xl mx-auto px-4 pt-3" aria-label="店鋪分頁">
      <div class="flex gap-1.5 p-1 rounded-2xl bg-slate-200/70 max-w-md mx-auto" role="tablist">
        <button type="button" id="tabSale" role="tab" data-tab="sale" aria-selected="true" class="tab flex-1 h-10 rounded-xl text-sm font-bold bg-slate-900 text-white">目前在售（{cases.length}）</button>
        <button type="button" id="tabSold" role="tab" data-tab="sold" aria-selected="false" class="tab flex-1 h-10 rounded-xl text-sm font-bold text-slate-700">最近成交（{soldList.length}）</button>
      </div>
    </nav>
  )}

  <div id="panelSale">
  <section class="sticky top-0 z-30 bg-slate-50/95 backdrop-blur-md border-b border-slate-200/70">
    <div class="max-w-5xl mx-auto px-4 pt-3 pb-2">
      <div class="space-y-2 pb-2" id="chips">
        <div class="flex flex-wrap items-center gap-2">
          {roomChips.map(([v, label]) => (
            <button type="button" data-g="rooms" data-v={v} aria-pressed="false" class={CHIP}>{label}</button>
          ))}
          <button type="button" id="advBtn" aria-expanded="false" class={`${CHIP} ml-auto`}>進階</button>
        </div>
        <div class="flex flex-wrap gap-2">
          {condChips.map(([g, v, label]) => (
            <button type="button" data-g={g} data-v={v} aria-pressed="false" class={CHIP}>{label}</button>
          ))}
        </div>
        <div id="advPanel" class="hidden space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-slate-600 shrink-0">租／售</span>
            {dealChips.map(([v, label]) => (
              <button type="button" data-g="deal" data-v={v} aria-pressed="false" class={CHIP}>{label}</button>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-slate-600 shrink-0">生活圈</span>
            {areaChips.map(([v, label]) => (
              <button type="button" data-g="areas" data-v={v} aria-pressed="false" class={CHIP}>{label}</button>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-slate-600 shrink-0">屋齡</span>
            {ageChips.map(([v, label]) => (
              <button type="button" data-g="ages" data-v={v} aria-pressed="false" class={CHIP}>{label}</button>
            ))}
          </div>
          <div class="flex flex-wrap gap-2">
            {advChips.map(([g, v, label]) => (
              <button type="button" data-g={g} data-v={v} data-adv="1" aria-pressed="false" class={CHIP}>{label}</button>
            ))}
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sm font-semibold text-slate-600 shrink-0">總價</span>
            <select id="priceMin" aria-label="最低總價" class="flex-1 min-w-0 h-9 text-sm px-3 rounded-xl border border-slate-200 bg-white">
              <option value="">不限</option>
              {PRICE_STEPS.map((n) => <option value={n}>{priceLabel(n)}</option>)}
            </select>
            <span class="text-slate-400 shrink-0">～</span>
            <select id="priceMax" aria-label="最高總價" class="flex-1 min-w-0 h-9 text-sm px-3 rounded-xl border border-slate-200 bg-white">
              <option value="">不限</option>
              {PRICE_STEPS.map((n) => <option value={n}>{priceLabel(n)}</option>)}
            </select>
          </div>
        </div>
      </div>
      <div class="flex gap-2">
        <select id="district" aria-label="區域" class="flex-1 text-sm px-3 py-2 rounded-xl border border-slate-200 bg-white">
          <option value="">全部區域</option>
          {districts.map((d) => <option value={d}>{d}</option>)}
        </select>
        <select id="sort" aria-label="排序" class="flex-1 text-sm px-3 py-2 rounded-xl border border-slate-200 bg-white">
          <option value="new">預設排序</option>
          <option value="asc">總價低到高</option>
          <option value="desc">總價高到低</option>
        </select>
      </div>
      <div class="flex items-center justify-between mt-2">
        <p class="text-xs text-slate-400" id="count">共 {cases.length} 間</p>
        <button type="button" id="clearBtn" class="hidden text-xs font-semibold text-slate-600 underline underline-offset-2 px-1 py-1">清除</button>
      </div>
    </div>
  </section>

  <main class="max-w-5xl mx-auto px-4 py-4">
    <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cases.map((c, i) => (
        <a href={`/p/${c.id}`} class="card block bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-md transition-shadow" data-id={c.id} data-kind={c.kind} data-district={c.district} data-price={c.price} data-i={i}
          data-age={c.age ?? ''} data-rooms={c.flags.rooms ?? ''}data-parking={c.flags.parking ? '1' : ''} data-elevator={c.flags.elevator ? '1' : ''} data-apartment={c.flags.apartment ? '1' : ''} data-townhouse={c.flags.townhouse ? '1' : ''} data-factory={c.flags.factory ? '1' : ''} data-land={c.flags.land ? '1' : ''}>
          <div class="relative aspect-[4/3] bg-slate-100 grid place-items-center text-slate-300 text-sm">
            {c.cover ? <img src={c.cover} alt={c.name} class="w-full h-full object-cover" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" /> : <span>照片整理中</span>}
            <div class="absolute top-2.5 left-2.5 flex gap-1.5">
              {c.isNew && <span class="bg-rose-600/95 text-white text-[11px] font-bold px-2.5 py-1 rounded-md">✨ 新上架</span>}
              {c.cut > 0 && <span class="bg-rose-600/95 text-white text-[11px] font-bold px-2.5 py-1 rounded-md">🔥 降 {c.cut.toLocaleString('en-US')} 萬</span>}
            </div>
          </div>
          <div class="p-4">
            <p class="text-xs text-slate-400 font-medium">{c.district}{c.road ? `・${c.road}` : ''}</p>
            <h2 class="text-base font-bold text-slate-900 leading-snug mt-0.5 line-clamp-2">{c.name}</h2>
            <p class="text-xs text-slate-500 mt-1.5">{[c.type, c.rooms, c.ping ? `${c.ping} 坪` : ''].filter(Boolean).join('｜')}</p>
            <p class="mt-2 flex items-baseline gap-1">
              <span class="text-2xl font-black text-rose-600 tracking-tight">{c.priceNum}</span>
              <span class="text-sm font-extrabold text-rose-600">{c.priceUnit}</span>
            </p>
          </div>
        </a>
      ))}
    </div>
    <p id="empty" class="hidden text-center text-slate-400 text-sm py-12">這個條件目前沒有房子，換個條件看看，或直接 LINE 我。</p>
  </main>
  </div>

  {soldList.length > 0 && (
    <div id="panelSold" class="hidden">
      <main class="max-w-5xl mx-auto px-4 py-4">
        <div class="text-center mb-4">
          <h2 class="text-lg font-black text-slate-900">最近成交的房子</h2>
          <p class="text-sm text-slate-600 mt-1">近 6 個月已成交的案子。想買類似的，或想知道自己的房子行情，直接 LINE 我。</p>
        </div>
        <div id="soldGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {soldList.map((s, i) => (
            <article class="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm" data-id={s.id}>
              <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 grid place-items-center text-slate-300 text-sm">
                {s.cover ? <img src={s.cover} alt={s.name} class="w-full h-full object-cover" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" /> : <span>照片整理中</span>}
              </div>
              <div class="p-4">
                <div class="relative flex items-center h-14 mb-1">
                  {s.priceNum && (
                    <span class="relative inline-flex items-baseline gap-1 px-1">
                      <span class="text-2xl font-black text-rose-600 tracking-tight">{s.priceNum}</span>
                      <span class="text-sm font-extrabold text-rose-600">{s.priceUnit}</span>
                      <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                        <line x1="2" y1="2" x2="98" y2="38" stroke="#1e293b" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                        <line x1="98" y1="2" x2="2" y2="38" stroke="#1e293b" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                      </svg>
                    </span>
                  )}
                  <span class="ml-4 -rotate-6 whitespace-nowrap border-4 border-rose-600 text-rose-600 bg-white/60 rounded-xl px-3 py-0.5 text-2xl font-black tracking-widest select-none">已成交</span>
                </div>
                <p class="text-xs text-slate-400 font-medium">{s.place}</p>
                <h3 class="text-base font-bold text-slate-900 leading-snug mt-0.5 line-clamp-2">{s.name}</h3>
                {s.info && <p class="text-xs text-slate-500 mt-1.5">{s.info}</p>}
                <div class="grid grid-cols-2 gap-2 mt-3">
                  <a href={s.buyHref} target="_blank" rel="noopener" class="bg-line text-white h-10 rounded-xl text-sm font-bold flex items-center justify-center">我想買類似的</a>
                  <a href={s.sellHref} target="_blank" rel="noopener" class="h-10 rounded-xl text-sm font-bold flex items-center justify-center border border-slate-300 text-slate-800 bg-white">我想估價</a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="text-center mt-6">
          <a href={AGENT.line} target="_blank" rel="noopener" class="bg-line text-white inline-flex h-12 px-6 rounded-xl text-sm font-bold items-center justify-center">加 LINE 跟莎拉聊聊</a>
        </div>
      </main>
    </div>
  )}

  <footer class="max-w-5xl mx-auto px-4 pb-6 text-center text-xs text-slate-400 space-y-1">
    <div>{AGENT.company}｜{AGENT.store}</div>
    <div>{AGENT.broker}</div>
    <div>{AGENT.agent}</div>
    <div>資料來源：永慶不動產公開物件資料，實際以現場及地政機關登記為準。</div>
    <div class="pt-2 space-x-3">
      <a href="/" class="text-slate-500">莎拉好房首頁</a>
      <a href="/communities" class="text-slate-500">社區資料庫</a>
      <a href="/articles" class="text-slate-500">不動產知識</a>
      <a href="/contact" class="text-slate-500">我要賣屋</a>
    </div>
  </footer>

  <div class="fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200/90 py-2.5 px-4 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
    <div class="max-w-md mx-auto flex items-center space-x-2.5" style="padding-bottom: env(safe-area-inset-bottom)">
      <a href={`tel:${AGENT.tel}`} class="flex-1 bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-bold h-12 rounded-xl flex items-center justify-center space-x-1.5 shadow-sm transition-transform">
        <Icon name="phone-call" class="w-4 h-4 text-amber-400" />
        <span class="text-sm">撥打電話</span>
      </a>
      <a href={AGENT.line} target="_blank" rel="noopener" class="flex-[1.3] bg-line hover:bg-lineHover active:scale-95 text-white font-bold h-12 rounded-xl flex items-center justify-center shadow-md transition-transform">
        <span class="text-sm">加 LINE 找房</span>
      </a>
    </div>
  </div>

  <script>
    import { emptySelection, hasSelection, matches, rentFlagsOf } from '../lib/caseFilter';
    import type { AgeKey, Flags, RoomKey, TypeKey } from '../lib/caseFilter';
    import { rentCardHtml } from '../lib/rentCard';
    import type { Rental } from '../lib/rentCard';
    if (new URLSearchParams(location.search).get('act') === 'book') document.getElementById('bookNote')?.classList.remove('hidden');
    const grid = document.getElementById('grid')!;
    const cards: HTMLElement[] = [...grid.querySelectorAll<HTMLElement>('.card')];
    const districtSel = document.getElementById('district') as HTMLSelectElement;
    const sortSel = document.getElementById('sort') as HTMLSelectElement;
    const chipBtns = [...document.querySelectorAll<HTMLElement>('#chips [data-g]')];
    const advBtn = document.getElementById('advBtn')!;
    const advPanel = document.getElementById('advPanel')!;
    const clearBtn = document.getElementById('clearBtn')!;
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const ON = ['bg-slate-900', 'text-white', 'border-slate-900'];
    const OFF = ['bg-white', 'text-slate-700', 'border-slate-200'];
    const sel = emptySelection();
    const flagsOfCard = (c: HTMLElement): Flags => {
      const d = c.dataset;
      return { rooms: d.rooms === '' ? null : Number(d.rooms), price: Number(d.price) > 0 ? Number(d.price) : null, parking: !!d.parking, elevator: !!d.elevator, apartment: !!d.apartment, townhouse: !!d.townhouse, factory: !!d.factory, land: !!d.land, rent: d.rent === '1', age: d.age === '' || d.age === undefined ? null : Number(d.age), area: null };
    };
    const cardFlags = new Map(cards.map((c) => [c, flagsOfCard(c)]));
    const setOn = (el: HTMLElement, on: boolean) => {
      el.classList.remove(...(on ? OFF : ON));
      el.classList.add(...(on ? ON : OFF));
    };
    function toggle<T>(s: Set<T>, v: T) {
      if (s.has(v)) s.delete(v);
      else s.add(v);
    }
    // 按鈕的亮暗、「進階（N）」的數字、「清除」要不要出現
    function paint() {
      for (const b of chipBtns) {
        const v = b.dataset.v!;
        const g = b.dataset.g;
        const on = g === 'rooms' ? sel.rooms.has(v as RoomKey) : g === 'parking' ? sel.parking : g === 'deal' ? sel.deal === v : g === 'ages' ? sel.ages.has(v as AgeKey) : g === 'areas' ? sel.areas.has(v) : sel.types.has(v as TypeKey);
        setOn(b, on);
        b.setAttribute('aria-pressed', String(on));
      }
      const hasPrice = sel.priceMin !== null || sel.priceMax !== null;
      const n = (['factory', 'land'] as TypeKey[]).filter((k) => sel.types.has(k)).length + (hasPrice ? 1 : 0) + (sel.deal ? 1 : 0) + (sel.ages.size ? 1 : 0) + (sel.areas.size ? 1 : 0);
      // 只看出租時，排序寫月租（出租沒有總價）
      const rentOnly = sel.deal === 'rent';
      sortSel.options[1].textContent = rentOnly ? '月租低到高' : '總價低到高';
      sortSel.options[2].textContent = rentOnly ? '月租高到低' : '總價高到低';
      advBtn.textContent = n ? `進階（${n}）` : '進階';
      setOn(advBtn, n > 0);
      clearBtn.classList.toggle('hidden', !hasSelection(sel));
    }
    function apply() {
      let shown = 0;
      for (const c of cards) {
        const ok = matches(cardFlags.get(c)!, sel) && (!districtSel.value || c.dataset.district === districtSel.value);
        c.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      // 出售與出租分開排：出售在前（依總價或預設順序），出租在後（依月租或預設順序）
      const grp = (c: HTMLElement) => (c.dataset.rent === '1' ? 1 : 0);
      const ordered = [...cards];
      if (sortSel.value === 'asc') ordered.sort((a, b) => grp(a) - grp(b) || +a.dataset.price! - +b.dataset.price!);
      else if (sortSel.value === 'desc') ordered.sort((a, b) => grp(a) - grp(b) || +b.dataset.price! - +a.dataset.price!);
      else ordered.sort((a, b) => +a.dataset.i! - +b.dataset.i!);
      ordered.forEach((c) => grid.appendChild(c));
      count.textContent = `共 ${shown} 間`;
      empty.classList.toggle('hidden', shown > 0);
      empty.textContent = sel.deal !== '' && rentalsFailed ? '出租案件暫時讀不到，請直接 LINE 我，我馬上回覆您。'
        : sel.areas.size && areasFailed ? '生活圈暫時讀不到，請先不選生活圈，或直接 LINE 我。'
        : '這個條件目前沒有房子，換個條件看看，或直接 LINE 我。';
    }
    chipBtns.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.v!;
      if (b.dataset.g === 'rooms') toggle(sel.rooms, v as RoomKey);
      else if (b.dataset.g === 'parking') sel.parking = !sel.parking;
      else if (b.dataset.g === 'deal') sel.deal = v as typeof sel.deal;
      else if (b.dataset.g === 'ages') toggle(sel.ages, v as AgeKey);
      else if (b.dataset.g === 'areas') toggle(sel.areas, v);
      else toggle(sel.types, v as TypeKey);
      paint();
      apply();
    }));
    advBtn.addEventListener('click', () => {
      const open = advPanel.classList.toggle('hidden') === false;
      advBtn.setAttribute('aria-expanded', String(open));
    });
    const priceMinSel = document.getElementById('priceMin') as HTMLSelectElement;
    const priceMaxSel = document.getElementById('priceMax') as HTMLSelectElement;
    const readPrice = () => {
      sel.priceMin = priceMinSel.value ? Number(priceMinSel.value) : null;
      sel.priceMax = priceMaxSel.value ? Number(priceMaxSel.value) : null;
      paint();
      apply();
    };
    priceMinSel.addEventListener('change', readPrice);
    priceMaxSel.addEventListener('change', readPrice);
    clearBtn.addEventListener('click', () => {
      sel.rooms.clear();
      sel.parking = false;
      sel.types.clear();
      priceMinSel.value = '';
      priceMaxSel.value = '';
      sel.priceMin = null;
      sel.priceMax = null;
      sel.deal = '';
      sel.ages.clear();
      sel.areas.clear();
      paint();
      apply();
    });
    districtSel.addEventListener('change', apply);
    sortSel.addEventListener('change', apply);

    // 出租案件：開頁面時去後台的公開窗口讀（只有租屋網上本來就公開的欄位），畫成卡片放在出售案件後面。
    // 預設不出現，要在「進階」選「出租」或「租和售」才會顯示。讀不到就維持現狀，選了出租會提示請直接 LINE。
    let rentalsFailed = false;
    (async () => {
      try {
        const KEY = 'sb_publishable_TFAFZE-d5n0ElisMATr9rw_ku8be1xT';
        const res = await fetch('https://dlfleszjcfeickibjcee.supabase.co/rest/v1/rpc/store_rentals', {
          method: 'POST', headers: { apikey: KEY, Authorization: 'Bearer ' + KEY, 'Content-Type': 'application/json' }, body: '{}',
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const list = (await res.json()) as Rental[];
        if (!Array.isArray(list)) throw new Error('格式不對');
        const tpl = document.createElement('template');
        tpl.innerHTML = list.map((r, i) => rentCardHtml(r, i)).join('');
        const known = new Set([...districtSel.options].map((o) => o.value));
        const els = [...tpl.content.children] as HTMLElement[]; // 先收齊再搬：搬走一張，原本的順序會跟著變
        list.forEach((r, i) => {
          const el = els[i];
          if (!el) return;
          grid.appendChild(el);
          cards.push(el);
          cardFlags.set(el, rentFlagsOf(r));
          if (r.district && !known.has(r.district)) {
            known.add(r.district);
            districtSel.add(new Option(r.district, r.district));
          }
        });
      } catch {
        rentalsFailed = true;
      }
      apply();
    })();

    // 生活圈：出售案件的生活圈（官網案號 → 生活圈），開頁面時去後台的公開窗口讀；只有路名／莎拉標的結果，沒有任何私有資料。
    // 讀不到就維持現狀（選了生活圈會提示），不影響其他篩選。
    let areasFailed = false;
    (async () => {
      try {
        const KEY = 'sb_publishable_TFAFZE-d5n0ElisMATr9rw_ku8be1xT';
        const res = await fetch('https://dlfleszjcfeickibjcee.supabase.co/rest/v1/rpc/store_areas', {
          method: 'POST', headers: { apikey: KEY, Authorization: 'Bearer ' + KEY, 'Content-Type': 'application/json' }, body: '{}',
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const map = (await res.json()) as Record<string, string>;
        if (!map || typeof map !== 'object' || Array.isArray(map)) throw new Error('格式不對');
        for (const c of cards) {
          const area = c.dataset.id ? map[c.dataset.id] : undefined;
          if (area) cardFlags.get(c)!.area = area;
        }
      } catch {
        areasFailed = true;
      }
      apply();
    })();

    // 瀏覽器重新整理時會記住下拉選項，載入時先讀一次，畫面和篩選才會一致
    readPrice();
  </script>

  <script>
    // 「目前在售｜最近成交」兩個分頁：網址 #sold 直接開最近成交，方便莎拉把連結傳給客人
    const tabs = [...document.querySelectorAll<HTMLElement>('.tab')];
    const panelSale = document.getElementById('panelSale');
    const panelSold = document.getElementById('panelSold');
    if (tabs.length && panelSale && panelSold) {
      const ON = ['bg-slate-900', 'text-white'];
      const OFF = ['text-slate-700'];
      const show = (which: 'sale' | 'sold') => {
        panelSale.classList.toggle('hidden', which !== 'sale');
        panelSold.classList.toggle('hidden', which !== 'sold');
        for (const t of tabs) {
          const on = t.dataset.tab === which;
          t.classList.remove(...(on ? OFF : ON));
          t.classList.add(...(on ? ON : OFF));
          t.setAttribute('aria-selected', String(on));
        }
      };
      tabs.forEach((t) => t.addEventListener('click', () => {
        const which = t.dataset.tab === 'sold' ? 'sold' : 'sale';
        history.replaceState(null, '', which === 'sold' ? '#sold' : location.pathname + location.search);
        show(which);
      }));
      window.addEventListener('hashchange', () => show(location.hash === '#sold' ? 'sold' : 'sale'));
      if (location.hash === '#sold') show('sold');
    }
  </script>
</StoreLayout>
