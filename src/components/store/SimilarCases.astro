---
// 單案頁最下面的「類似的房子」：一排卡片，手機可以左右滑，點進去是那一間。
// 找法與排序在 src/lib/similar.ts（同社區最優先；之後依序看總價、房數、車位相近）。
import { districtOf, photosOf, priceParts, roadOf, titleOf } from '../../lib/store';
import type { Similar } from '../../lib/similar';

const { items } = Astro.props as { items: Similar<any>[] };
const REASON: Record<string, string> = { community: '同社區', district: '' };
---
{items.length > 0 && (
  <section class="py-5 border-b border-slate-100" aria-label="類似的房子">
    <h2 class="px-5 text-base font-bold text-slate-900">類似的房子</h2>
    <p class="px-5 text-xs text-slate-400 mt-0.5">同社區優先，總價、房數、車位相近的排在前面</p>
    <div class="mt-3 flex gap-3 overflow-x-auto snap-x snap-mandatory px-5 pb-2" style="scrollbar-width: none;">
      {items.map(({ item: it, reason }) => {
        const [pn, pu] = priceParts(it.price);
        const cut = it.originalPrice && it.price && it.originalPrice > it.price ? it.originalPrice - it.price : 0;
        const cover = photosOf(it)[0] || '';
        const spec = [it.type, it.rooms, (it.buildingPing || it.landPing) ? `${it.buildingPing || it.landPing} 坪` : ''].filter(Boolean).join('｜');
        const place = `${districtOf(it)}${roadOf(it) ? `・${roadOf(it)}` : ''}`;
        return (
          <a href={`/p/${it.id}`} class="similar-card snap-start shrink-0 w-[168px] block bg-white rounded-xl overflow-hidden border border-slate-100 shadow-sm">
            <div class="relative aspect-[4/3] bg-slate-100 grid place-items-center text-slate-300 text-xs">
              {cover ? <img src={cover} alt={titleOf(it)} class="w-full h-full object-cover" loading="lazy" decoding="async" /> : <span>照片整理中</span>}
              <div class="absolute top-1.5 left-1.5 flex flex-col items-start gap-1">
                {REASON[reason] && <span class="bg-slate-900/80 text-amber-200 text-[10px] font-bold px-1.5 py-0.5 rounded">{REASON[reason]}</span>}
                {cut > 0 && <span class="bg-rose-600/95 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">🔥 降 {cut.toLocaleString('en-US')} 萬</span>}
              </div>
            </div>
            <div class="p-2.5">
              <p class="text-[11px] text-slate-400 font-medium truncate">{place}</p>
              <h3 class="text-sm font-bold text-slate-900 leading-snug mt-0.5 line-clamp-2">{titleOf(it)}</h3>
              <p class="text-[11px] text-slate-500 mt-1 truncate">{spec}</p>
              <p class="mt-1.5 flex items-baseline gap-0.5">
                <span class="text-lg font-black text-rose-600 tracking-tight">{pn}</span>
                <span class="text-xs font-extrabold text-rose-600">{pu}</span>
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
